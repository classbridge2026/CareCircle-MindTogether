# Copy this file to .env and replace the placeholders with your Neon connection strings.
# DATABASE_URL = pooled connection (hostname includes -pooler)
# DIRECT_URL   = direct connection (hostname does not include -pooler)

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Public origin used to build verification links. No trailing slash.
APP_BASE_URL="http://localhost:3000"

# Long random string. Required in production for phone-code hashes and IP hashes.
# Do not commit a real value.
# VERIFICATION_PEPPER=

# Gmail SMTP. Port 465 uses SSL. SMTP_PASS is a Google App Password, not the account password.
# https://nodemailer.com/guides/using-gmail
# Leave SMTP_PASS unset until you create an App Password. Messages stay unsent until every value is set.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="account@example.com"
SMTP_PASS=""
# Use the same Gmail address as SMTP_USER. A different From address is treated as suspicious.
EMAIL_FROM="CareCircle MindTogether <account@example.com>"
#
# Vercel: open the project, then Settings, then Environment Variables.
# Add SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, EMAIL_FROM, and APP_BASE_URL
# for Production and Preview. Mark SMTP_PASS as sensitive. Redeploy after saving.
# Do not paste these values into client code. The application reads them only on the server.
#
# Development-only check, after the variables are set locally:
# node scripts/send-test-email.mjs recipient@example.com
# The script refuses to run when NODE_ENV is production.

# One-time administrator account. Used only by `npm run db:seed`.
# Do not commit real values. Re-running the seed updates that account's password.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Appointment clock. Vercel Cron calls GET /api/jobs/appointment-clock on the schedule in vercel.json.
# The route accepts the call only when Authorization is Bearer <this value>.
# The checked-in schedule is once a day at 08:00 UTC, which a Vercel Hobby project accepts.
# On Vercel Pro, change vercel.json to `0 * * * *` so day-before and hour-before reminders are not missed.
# The job expires unpaid holds and sends those reminders.
# It uses the Gmail SMTP settings above. It does not send text messages.
# Vercel Cron sends that header when CRON_SECRET is set on the project. Mark it sensitive.
# CRON_SECRET=

# Optional. Maximum clinical upload size in bytes. The application never accepts more than 10485760.
# CLINICAL_MAX_UPLOAD_BYTES=10485760
# Set to true only after a malware scanner is connected. Uploads are refused while this is true
# because no scanner is configured. Leaving it unset records scan status as not configured.
# That status is not a clean scan. File type is still checked from the file signature.
# CLINICAL_MALWARE_SCAN_REQUIRED=false
#
# Guardian access to released summaries is a database platform setting, not an environment variable.
# Key: GUARDIAN_RELEASED_RECORD_ACCESS
# JSON true enables it. A missing row or any other value denies it.
# The guardian still needs an AUTHORIZED, unexpired relationship, a current GUARDIAN_AUTHORIZATION
# consent, and a minor or dependent patient. Private notes stay unavailable.
# Removed clinical files stay in private storage. The application does not purge them.

# Private credential storage. Do not point this at the public web folder.
# STORAGE_PROVIDER=filesystem
# STORAGE_LOCAL_ROOT=
# Or use S3-compatible storage:
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_FORCE_PATH_STYLE=false

# Optional. Set the JSON value to true when identity documents are mandatory.
# Platform setting key: DOCTOR_IDENTITY_DOCUMENT_REQUIRED

# LiveKit Cloud. Server-only. Never prefix these with NEXT_PUBLIC_.
# LIVEKIT_URL is the WebSocket URL, normally wss:// for LiveKit Cloud.
# LIVEKIT_API_SECRET must stay on the server. Do not put a real secret in this file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional. Defaults to 600 seconds. Allowed range: 60–900.
LIVEKIT_TOKEN_TTL_SECONDS=
# Optional. Minutes before the appointment when join opens. Defaults to 15. Allowed range: 5–120.
LIVEKIT_JOIN_WINDOW_MINUTES=